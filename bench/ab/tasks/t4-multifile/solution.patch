 @dataclass
 class Cart:
@@ -12,6 +14,10 @@ class Cart:
 
 def add_item(cart, sku, qty=1):
     """Add ``qty`` units of ``sku``; return the new quantity for that line."""
+    if not isinstance(sku, str) or not sku.strip():
+        raise ValidationError("sku", "must be a non-empty string")
+    if isinstance(qty, bool) or not isinstance(qty, int) or qty < 1:
+        raise ValidationError("qty", "must be a positive integer")
     cart.lines[sku] = cart.lines.get(sku, 0) + qty
     return cart.lines[sku]
 
diff --git a/shop/errors.py b/shop/errors.py
new file mode 100644
index 0000000..6f722e2
--- /dev/null
+++ b/shop/errors.py
@@ -0,0 +1,13 @@
+"""Shared error types for the shop package."""
+
+
+class ValidationError(ValueError):
+    """Raised when a caller passes an invalid argument.
+
+    ``field`` names the offending parameter so API layers can report it.
+    """
+
+    def __init__(self, field, message):
+        super().__init__(f"{field}: {message}")
+        self.field = field
+        self.message = message
diff --git a/shop/pricing.py b/shop/pricing.py
index af800bc..f98ff65 100644
--- a/shop/pricing.py
+++ b/shop/pricing.py
@@ -1,8 +1,14 @@
 """Price arithmetic. Prices are integer cents."""
+from .errors import ValidationError
 
 
 def apply_discount(price_cents, percent):
     """Return the discounted price, rounded to the nearest cent."""
+    if isinstance(price_cents, bool) or not isinstance(price_cents, int) or price_cents < 0:
+        raise ValidationError("price_cents", "must be a non-negative integer")
+    if isinstance(percent, bool) or not isinstance(percent, (int, float)) \
+            or not 0 <= percent <= 100:
+        raise ValidationError("percent", "must be between 0 and 100")
     return round(price_cents * (100 - percent) / 100)
 
 
