diff --git a/tests/test_ttl.py b/tests/test_ttl.py
new file mode 100644
index 0000000..cd33c89
--- /dev/null
+++ b/tests/test_ttl.py
@@ -0,0 +1,21 @@
+import unittest
+
+from kvsvc.handler import Handler
+from kvsvc.store import KVStore
+
+
+class TtlTest(unittest.TestCase):
+    def test_expiry_and_stats(self):
+        now = [0.0]
+        h = Handler(KVStore(clock=lambda: now[0]))
+        h.handle({"op": "set", "key": "a", "value": 1, "ttl": 2})
+        self.assertEqual(h.handle({"op": "get", "key": "a"})["value"], 1)
+        now[0] = 2.0
+        self.assertEqual(h.handle({"op": "get", "key": "a"})["error"], "not_found")
+        self.assertEqual(h.handle({"op": "stats"}),
+                         {"ok": True, "hits": 1, "misses": 1, "expired": 1, "keys": 0})
+
+    def test_bad_ttl(self):
+        h = Handler(KVStore())
+        self.assertEqual(h.handle({"op": "set", "key": "a", "value": 1, "ttl": 0})["error"],
+                         "bad_request")
