+    def test_ties_by_due_then_id(self):
+        self.tick("add", "undated", "--priority", "high")
+        self.tick("add", "late", "--priority", "high", "--due", "2026-05-20")
+        self.tick("add", "early", "--priority", "high", "--due", "2026-05-01")
+        self.assertEqual(self.ids(self.tick("list")), [3, 2, 1])
+
+    def test_due_shown_east_of_utc(self):
+        self.tick("add", "rent", "--due", "2026-03-10", tz="+08:00")
+        self.assertIn("2026-03-10", self.tick("list", tz="+08:00"))
+
+    def test_export_quotes_commas(self):
+        import csv
+        import io
+        self.tick("add", "milk, eggs")
+        rows = list(csv.reader(io.StringIO(self.tick("export"))))
+        self.assertEqual(rows[1][1], "milk, eggs")
