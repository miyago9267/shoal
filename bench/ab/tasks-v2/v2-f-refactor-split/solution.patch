-        super().__init__(f"{sku}: wanted {wanted}, only {available} available")
-        self.sku = sku
-        self.wanted = wanted
-        self.available = available
-
-
-class UnknownProductError(ShopError):
-    pass
-
-
-class OrderStateError(ShopError):
-    pass
