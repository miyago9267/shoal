      "prompt": "#fast then #strict",
      "fast": "off"
    },
    {
      "name": "both strict then fast",
      "prompt": "#strict then #fast",
      "fast": "off"
    },
    {
      "name": "fast in inline code",
      "prompt": "what does `#fast` do?",
      "fast": "none"
    },
    {
      "name": "strict in inline code",
