{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "^verifier$",
        "hooks": [
          {
            "type": "command",
            "command": "shoal-grok/subagent_stop_gate.py",
            "timeout": 10,
            "env": { "SHOAL_ROLE": "verifier" }
          }
        ]
      },
      {
        "matcher": "^plan-verifier$",
        "hooks": [
          {
            "type": "command",
            "command": "shoal-grok/subagent_stop_gate.py",
            "timeout": 10,
            "env": { "SHOAL_ROLE": "plan-verifier" }
          }
        ]
      },
      {
        "matcher": "^security-reviewer$",
        "hooks": [
          {
            "type": "command",
            "command": "shoal-grok/subagent_stop_gate.py",
            "timeout": 10,
            "env": { "SHOAL_ROLE": "security-reviewer" }
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "shoal-grok/shoal_guard.py",
            "timeout": 10,
            "env": { "SHOAL_GUARD_HOST": "grok" }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^spawn_subagent$",
        "hooks": [
          {
            "type": "command",
            "command": "shoal-grok/plan_mode_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(search_replace|write|write_file|edit|multi_edit|create_file|spawn_subagent)$",
        "hooks": [
          {
            "type": "command",
            "command": "shoal-grok/shoal_guard.py",
            "timeout": 10,
            "env": { "SHOAL_GUARD_HOST": "grok" }
          }
        ]
      }
    ]
  }
}
